generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agent {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  matricule String   @unique
  agence    String
  photoUrl  String?  @db.Text
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
    sexe      String?
  fonction  String   @default("Agent de sécurité")

  cards Card[]
}

model Card {
  id        String    @id @default(uuid())
  token     String    @unique
  statut    String    @default("actif") // "actif" | "desactive" | "revoque"
  expireAt  DateTime?
    issuedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  logs VerificationLog[]
}

model VerificationLog {
  id        String   @id @default(uuid())
  resultat  String   // "valide" | "invalide"
  scannedAt DateTime @default(now())
  ipAddress String?

  cardId String?
  card   Card?   @relation(fields: [cardId], references: [id])
}
model Settings {
  id               String  @id @default("main")
  nomOrganisation  String  @default("SecuriApp")
  dureeValiditeJours Int   @default(365)
}
model Admin {
  id             String    @id @default(uuid())
  email          String    @unique
  nom            String
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
}